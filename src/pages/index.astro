---
import Layout from '../layouts/Layout.astro';
import WorkoutApp from '../features/workout/components/WorkoutApp';
---

<Layout>
  <div class="mx-auto flex min-h-svh max-w-6xl flex-col px-5 sm:px-10">
    <header class="flex flex-wrap items-center justify-between gap-4 border-b border-white/10 py-6 sm:py-7">
      <a href="/" aria-label="Rounds Up — início" class="flex items-center gap-2.5 text-xl font-bold tracking-tight">
        <svg viewBox="0 0 32 32" fill="none" aria-hidden="true" class="h-8 w-8 text-lime-300">
          <circle cx="16" cy="16" r="12" stroke="currentColor" stroke-width="2.5" />
          <path d="M10 19 21 12m-7 0h7v7" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" />
        </svg>
        <span>Rounds Up<span class="text-lime-300">.</span></span>
      </a>
      <span class="text-[10px] tracking-[0.16em] text-stone-400 uppercase sm:text-xs">Treinos em rounds</span>
    </header>
    <main id="main-content" class="flex-1 py-9 sm:py-12">
      <WorkoutApp client:load />
      <noscript><p class="mt-6 rounded-xl border border-amber-300/30 p-4 text-amber-200">Ative o JavaScript para configurar e executar o treino.</p></noscript>
    </main>
    <footer class="mt-10 flex flex-wrap justify-between gap-3 border-t border-white/10 py-6 text-xs text-stone-400">
      <span>Rounds Up · Seu treino. Seu ritmo. Seus rounds.</span>
      <span>Foco / Força / Consistência</span>
    </footer>
  </div>
</Layout>
